  targetDomain: string;
  actionId: string;
  sourceModule: 'CRM' | 'WMS' | 'TPR' | 'POWERSTARTER';
  payload: Record<string, any>;
}

class OnPremiseBridge {
  private socket: WebSocket | null = null;
  private messageListeners: Set<(data: OnPremiseEnvelope) => void> = new Set();

  /**
   * Initializes the persistent bidirectional communication channel with the local server.
   */
  public connect(gatewayUrl: string = "ws://gms.powerframe.local/stream-bridge"): void {
    this.socket = new WebSocket(gatewayUrl);

    this.socket.onmessage = (event) => {
      try {
        const decodedMessage: OnPremiseEnvelope = JSON.parse(event.data);
        
        // Broadcast incoming hardware triggers instantly to active memory observers
        this.messageListeners.forEach((listener) => listener(decodedMessage));
      } catch (error) {
        console.error("[On-Premise Bridge] Failed decoding local gateway payload:", error);
      }
    };

    this.socket.onclose = () => {
      console.warn("[On-Premise Bridge] Connection dropped. Retrying local socket handshake in 3s...");
      setTimeout(() => this.connect(gatewayUrl), 3000);
    };
  }

  /**
   * Dispatches an event envelope back into the Unity Engine or cross-platform tool loops (Bidirectional).
   */
  public emitToEcosystem(envelope: OnPremiseEnvelope): void {
    if (this.socket && this.socket.readyState === WebSocket.OPEN) {
      this.socket.send(JSON.stringify({
        ...envelope,
        _timestamp_unix_ms: Date.now()
      }));
    } else {
      console.error("[On-Premise Bridge] Aborted dispatch: Local runtime socket is disconnected.");
    }
  }

  public subscribe(callback: (data: OnPremiseEnvelope) => void) {
    this.messageListeners.add(callback);
    return () => this.messageListeners.delete(callback);
  }
}

export const onPremiseBridge = new OnPremiseBridge();
