  "$schema": "https://turbo.build",
  "tasks": {
    "build:web": {
      "dependsOn": ["^build:web"],
      "outputs": ["dist/**"]
    },
    "build:embedded": {
      "dependsOn": ["^build:embedded"],
      "outputs": ["src-tauri/target/**", "out/**", "build-desktop/**"]
    },
    "dev:local": {
      "cache": false,
      "persistent": true
    }
  }
}
