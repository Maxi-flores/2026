Use o código com cuidado.3. Implementing the Unified Hook: useEcosystemFeedOrchestrator.tsThis React 18 hook must be added to your Governance Plane to monitor both output systems in real time. It reads incoming browser messages and maps them to your design parameters:typescript// apps/governance-plane/src/hooks/useEcosystemFeedOrchestrator.ts
import { useState, useEffect, useCallback } from 'react';

export interface FeedPayloadEnvelope {
  type: 'POWERSTARTER_OUTPUT' | 'WAI_PORTFOLIO_UPDATE';
  originDomain: string;
  payload: Record<string, any>;
}

export interface OrchestratorFeedState {
  powerstarterStream: any[];
  waiPortfolioSnapshot: Record<string, any> | null;
  complianceAlerts: string[];
}

export function useEcosystemFeedOrchestrator(allowedDomain: string = "powerstarter.dev") {
  const [feedState, setFeedState] = useState<OrchestratorFeedState>({
    powerstarterStream: [],
    waiPortfolioSnapshot: null,
    complianceAlerts: []
  });

  const processIncomingFeed = useCallback((envelope: FeedPayloadEnvelope) => {
    setFeedState((prev) => {
      const updated = { ...prev };

      if (envelope.type === 'POWERSTARTER_OUTPUT') {
        // Enforce structural boundary rules for game generated outputs
        if (!envelope.payload.unity_tick_index) {
          updated.complianceAlerts.push("PowerStarter event dropped: missing unity_tick_index signature");
          return updated;
        }
        // Limit local memory streams to 100 historical buffer positions
        updated.powerstarterStream = [envelope.payload, ...prev.powerstarterStream].slice(0, 100);
      }

      if (envelope.type === 'WAI_PORTFOLIO_UPDATE') {
        // Map data criteria for WAI portfolios
        if (!envelope.payload.player_id) {
          updated.complianceAlerts.push("WAI portfolio sync rejected: missing valid player identification");
          return updated;
        }
        updated.waiPortfolioSnapshot = envelope.payload;
      }

      return updated;
    });
  }, []);

  useEffect(() => {
    const handleCrossDocumentEvent = (event: MessageEvent) => {
      // Security Gate: Block untrusted event injections
      if (event.origin !== `https://${allowedDomain}` && event.origin !== "http://localhost:5173") return;
      
      const { data } = event;
      if (!data || !data.type) return;

      processIncomingFeed({
        type: data.type,
        originDomain: event.origin,
        payload: data.payload
      });
    };

    window.addEventListener('message', handleCrossDocumentEvent);
    return () => window.removeEventListener('message', handleCrossDocumentEvent);
  }, [allowedDomain, processIncomingFeed]);

  return feedState;
}
