Task B: Implementation Code for src/orchestrator/platform_engine.pyThis updated engine dynamically queries the configuration file above, builds the paired dual-persona consensus prompts, tracks execution steps, and locks thread generation to your 4 physical P-Cores.pythonimport os
import json
import time
import requests
from collections import deque

OLLAMA_URL = "http://localhost:11434/api/generate"
MODEL_NAME = "qwen2.5-coder:3b"
REGISTRY_PATH = "config/agent_registry.json"
QUEUE_DIR = ".platform_queue"
MAX_CONTEXT_CHARS = 12000 # Memory-bounded safety horizon

class PairedEcosystemEngine:
    def __init__(self):
        self.load_registry()
        self.ensure_runtime_directories()
        print("⚡ Multi-Repo Paired Agent Engine Active.")
        print("🔒 4 P-Core constraint locked. OLLAMA_KEEP_ALIVE active.")

    def ensure_runtime_directories(self):
        os.makedirs(QUEUE_DIR, exist_ok=True)
        os.makedirs(os.path.join(QUEUE_DIR, "failed"), exist_ok=True)
        os.makedirs(".logs", exist_ok=True)

    def load_registry(self):
        with open(REGISTRY_PATH, "r", encoding="utf-8") as f:
            self.registry = json.load(f)

    def build_consensus_prompt(self, repo_name, current_turn, task_instruction, context_history):
        """Dynamically assembles the system context depending on the repo owner and turn"""
        repo_meta = self.registry["repositories"].get(repo_name, {"crew_type": "diagnostic_crew", "domain_rules": ""})
        crew_type = repo_meta["crew_type"]
        crew = self.registry["general_personas"][crew_type]
        
        # Alternate roles across the 5-iteration budget loop
        if current_turn % 2 == 1:
            active_role = crew["primary"]
            role_instruction = "You are the PRIMARY EXECUTOR. Write functional modifications or call necessary system tools."
        else:
            active_role = crew["twin"]
            role_instruction = "You are the TWIN AUDITOR. Critically review the previous turns output, catch regressions, check security bounds, and validate tool constraints."

        system_prompt = (
            f"Active Repository Context: {repo_name}\n"
            f"Assigned Crew Core Model: {crew_type.upper()}\n"
            f"Your Assigned Persona Role: {active_role}\n"
            f"Operational Directive: {role_instruction}\n"
            f"Domain Constraints to Enforce: {repo_meta['domain_rules']}\n\n"
            f"Universal Rule: You must output a JSON object containing 'tool_to_call' and 'arguments' "
            f"OR a 'final_response' if the task is thoroughly completed and validated by the Twin.\n"
        )
        
        return f"{system_prompt}\nInitial Task: {task_instruction}\n\nHistory Buffer:\n{context_history}"

    def query_ollama(self, system_prompt):
        # Enforce exact 4 thread runtime configuration to protect Meteor Lake P-Cores
        payload = {
            "model": MODEL_NAME,
            "prompt": system_prompt,
            "stream": False,
            "format": "json",
            "options": {"num_thread": 4}
        }
        try:
            response = requests.post(OLLAMA_URL, json=payload, timeout=30)
            return response.json().get("response", "{}")
        except Exception as e:
            return json.dumps({"error": f"Connection lost to Ollama daemon: {e}"})

    def route_and_execute(self, task_file_path):
        print(f"\n📬 Parsing task from: {task_file_path}")
        try:
            with open(task_file_path, "r", encoding="utf-8") as f:
                task_data = json.load(f)
        except Exception as e:
            print(f"❌ Aborting payload parsing error: {e}")
            return

        target_repo = task_data.get("repository", "Unknown")
        instruction = task_data.get("instruction", "")
        
        if target_repo not in self.registry["repositories"]:
            print(f"⚠️ Warning: '{target_repo}' not in config registry. Defaulting to Diagnostic Crew.")

        max_loops = 5
        current_loop = 0
        completed = False
        context_deque = deque(maxlen=MAX_CONTEXT_CHARS)
        
        print(f"🚀 Launching paired consensus loop for {target_repo}.")
        
        while current_loop < max_loops and not completed:
            current_loop += 1
            print(f"🔄 Execution loop sequence: {current_loop}/{max_loops}")
            
            flat_history = "".join(context_deque)
            full_prompt = self.build_consensus_prompt(target_repo, current_loop, instruction, flat_history)
            
            raw_output = self.query_ollama(full_prompt)
            
            try:
                decision = json.loads(raw_output)
                if "final_response" in decision:
                    print(f"🎉 Success Frame: {decision['final_response']}")
                    completed = True
                elif "tool_to_call" in decision:
                    tool_name = decision["tool_to_call"]
                    print(f"⚙️ Tool invoke requested: {tool_name}")
                    # Local mock tool execution injection point
                    mock_observation = f"Result payload mock output from tool '{tool_name}' executed cleanly."
                    context_deque.append(f"\n[Turn {current_loop}] Agent called '{tool_name}'. Observation: {mock_observation}")
                else:
                    context_deque.append(f"\n[Turn {current_loop}] System structure missing expected target properties.")
            except Exception as parse_error:
                print(f"❌ Structural schema validation crash: {parse_error}")
                context_deque.append(f"\n[Turn {current_loop}] Failed schema extraction on raw text.")

        if completed:
            os.remove(task_file_path)
            print("💾 Task finalized cleanly. Queue cleared.")
        else:
            print("⚠️ Max execution loop breaker reached! Isolating task.")
            failed_dest = os.path.join(QUEUE_DIR, "failed", os.path.basename(task_file_path))
            if os.path.exists(task_file_path):
                os.replace(task_file_path, failed_dest)

    def run_polling_worker(self):
        print("🕵️ 24/7 Workspace Loop actively tracking platform queue state...")
        target_job = os.path.join(QUEUE_DIR, "next_task.json")
        while True:
            if os.path.exists(target_job):
                self.route_and_execute(target_job)
            time.sleep(5)

if __name__ == "__main__":
    engine = PairedEcosystemEngine()
    engine.run_polling_worker()

